<?xml version="1.0" encoding="UTF-8"?>
<!--
  Process API orchestration tests. Every outbound call (System API, AI service,
  ERP via System API) is mocked by doc:name, so these tests run without any
  external system. AI mock payloads are real outputs of mock-services/mock_server.py
  for the files in /sample-invoices.
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

  <munit:config name="process-orchestration-test-suite.xml"/>

  <!-- Mocks shared by every scenario: invoice registration and persistence calls -->
  <sub-flow name="mock-common-system-calls">
    <munit-tools:mock-when processor="http:request">
      <munit-tools:with-attributes>
        <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Create invoice"/>
      </munit-tools:with-attributes>
      <munit-tools:then-return>
        <munit-tools:payload value="#[{ invoiceId: '5b6a7c00-0000-4000-8000-0000000000aa', status: 'RECEIVED', idempotentReplay: false }]" mediaType="application/json"/>
        <munit-tools:attributes value="#[{ statusCode: 201 }]"/>
      </munit-tools:then-return>
    </munit-tools:mock-when>
    <munit-tools:mock-when processor="http:request">
      <munit-tools:with-attributes>
        <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Update status"/>
      </munit-tools:with-attributes>
      <munit-tools:then-return>
        <munit-tools:payload value="#[{ status: 'OK' }]" mediaType="application/json"/>
        <munit-tools:attributes value="#[{ statusCode: 200 }]"/>
      </munit-tools:then-return>
    </munit-tools:mock-when>
    <munit-tools:mock-when processor="http:request">
      <munit-tools:with-attributes>
        <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Save extraction"/>
      </munit-tools:with-attributes>
      <munit-tools:then-return>
        <munit-tools:payload value="#[{ saved: true }]" mediaType="application/json"/>
        <munit-tools:attributes value="#[{ statusCode: 200 }]"/>
      </munit-tools:then-return>
    </munit-tools:mock-when>
    <munit-tools:mock-when processor="http:request">
      <munit-tools:with-attributes>
        <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Audit"/>
      </munit-tools:with-attributes>
      <munit-tools:then-return>
        <munit-tools:payload value="#[{ recorded: true }]" mediaType="application/json"/>
        <munit-tools:attributes value="#[{ statusCode: 200 }]"/>
      </munit-tools:then-return>
    </munit-tools:mock-when>
    <munit-tools:mock-when processor="http:request">
      <munit-tools:with-attributes>
        <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Enqueue recovery"/>
      </munit-tools:with-attributes>
      <munit-tools:then-return>
        <munit-tools:payload value="#[{ queueId: 1, status: 'PENDING' }]" mediaType="application/json"/>
        <munit-tools:attributes value="#[{ statusCode: 201 }]"/>
      </munit-tools:then-return>
    </munit-tools:mock-when>
  </sub-flow>

  <munit:test name="success-auto-approved-and-posted" tags="unit" description="Happy path: valid PDF under 1,000 is auto-approved and posted to the ERP">
    <munit:behavior>
      <flow-ref name="mock-common-system-calls"/>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="AI - Mock extract"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[readUrl('classpath://mocks/ai-auto-approve.json', 'application/json')]" mediaType="application/json"/>
          <munit-tools:attributes value="#[{ statusCode: 200 }]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Get vendor"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[readUrl('classpath://mocks/sys-vendor-v1001.json', 'application/json')]" mediaType="application/json"/>
          <munit-tools:attributes value="#[{ statusCode: 200 }]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Duplicate check"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[{ exactMatches: [], possibleMatches: [] }]" mediaType="application/json"/>
          <munit-tools:attributes value="#[{ statusCode: 200 }]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Get purchase order"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[readUrl('classpath://mocks/sys-po-2026-0001.json', 'application/json')]" mediaType="application/json"/>
          <munit-tools:attributes value="#[{ statusCode: 200 }]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="http:request">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Post to ERP"/>
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[{ invoiceId: 'x', erpStatus: 'POSTED', erpDocumentNumber: '5100000001', postedAt: '2026-10-13T09:00:00Z' }]" mediaType="application/json"/>
          <munit-tools:attributes value="#[{ statusCode: 200 }]"/>
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <munit:set-event>
        <munit:payload value="#[readUrl('classpath://requests/create-invoice-pdf.json', 'application/json')]" mediaType="application/json"/>
        <munit:attributes value="#[{ headers: { client_id: 'test-process-client', client_secret: 'test-process-secret' }, uriParams: {}, queryParams: {} }]"/>
      </munit:set-event>
      <flow-ref name="process-create-invoice-flow"/>
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('POSTED_TO_ERP')]"/>
      <munit-tools:assert-that expression="#[payload.erp.documentNumber]" is="#[MunitTools::equalTo('5100000001')]"/>
      <munit-tools:assert-that expression="#[payload.invoiceNumber]" is="#[MunitTools::equalTo('INV-2026-1001')]"/>
      <munit-tools:assert-that expression="#[sizeOf(payload.exceptions)]" is="#[MunitTools::equalTo(0)]"/>
      <munit-tools:verify-call processor="http:request" times="1">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Post to ERP"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
      <munit-tools:verify-call processor="http:request" times="0">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="SYS - Enqueue recovery"/>
        </munit-tools:with-attributes>
      </munit-tools:verify-call>
    </munit:validation>
  </munit:test>

