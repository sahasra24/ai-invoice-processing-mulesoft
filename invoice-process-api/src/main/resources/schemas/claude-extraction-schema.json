{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invoice_number", "invoice_date", "vendor_name", "vendor_id", "purchase_order_number",
    "billing_address", "currency", "line_items", "subtotal", "tax", "tax_rate", "total_amount",
    "payment_terms", "due_date", "field_confidence", "overall_confidence"
  ],
  "properties": {
    "invoice_number": { "anyOf": [{ "type": "string" }, { "type": "null" }], "description": "Invoice number exactly as printed" },
    "invoice_date": { "anyOf": [{ "type": "string" }, { "type": "null" }], "description": "Invoice date in ISO format YYYY-MM-DD" },
    "vendor_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "vendor_id": { "anyOf": [{ "type": "string" }, { "type": "null" }], "description": "Vendor/supplier ID printed on the invoice, e.g. V-1001" },
    "purchase_order_number": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "billing_address": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "currency": { "anyOf": [{ "type": "string" }, { "type": "null" }], "description": "ISO 4217 code, e.g. USD" },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_number", "item_code", "description", "quantity", "unit_price", "amount"],
        "properties": {
          "line_number": { "type": "integer" },
          "item_code": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "description": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "quantity": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "unit_price": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "amount": { "anyOf": [{ "type": "number" }, { "type": "null" }] }
        }
      }
    },
    "subtotal": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
    "tax": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
    "tax_rate": { "anyOf": [{ "type": "number" }, { "type": "null" }], "description": "Decimal fraction, 8% = 0.08" },
    "total_amount": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
    "payment_terms": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "due_date": { "anyOf": [{ "type": "string" }, { "type": "null" }], "description": "YYYY-MM-DD" },
    "field_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_number", "invoice_date", "vendor_name", "vendor_id", "purchase_order_number",
        "billing_address", "currency", "line_items", "subtotal", "tax", "total_amount", "payment_terms", "due_date"
      ],
      "properties": {
        "invoice_number": { "type": "number" },
        "invoice_date": { "type": "number" },
        "vendor_name": { "type": "number" },
        "vendor_id": { "type": "number" },
        "purchase_order_number": { "type": "number" },
        "billing_address": { "type": "number" },
        "currency": { "type": "number" },
        "line_items": { "type": "number" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "total_amount": { "type": "number" },
        "payment_terms": { "type": "number" },
        "due_date": { "type": "number" }
      }
    },
    "overall_confidence": { "type": "number" }
  }
}
