# ---------------------------------------------------------------------
# Environment variables for the three Mule applications.
# Every key overrides the property of the same name in config/local.yaml
# (environment variables have higher precedence than configuration files).
#
# Copy to config/.env, fill in, and load before starting the runtime:
#   PowerShell : .\tools\load-env.ps1
#   bash       : set -a; source config/.env; set +a
# In Anypoint Studio you can instead add them under
#   Run > Run Configurations > Mule Applications > (config) > Environment
# NEVER commit config/.env (it is in .gitignore).
# ---------------------------------------------------------------------

# ---- AI document extraction service ---------------------------------
MOCK_AI_HOST=localhost
MOCK_AI_PORT=8090
MOCK_AI_API_KEY=mock-ai-key-local

# ---- Database (System API) -----------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=invoice_db
DB_USER=invoice_app
DB_PASSWORD=ChangeMe_Local_2026!

# ---- Service-to-service credentials (same values in all apps) -------
# Experience -> Process
PROCESS_API_CLIENT_ID=invoice-experience-client
PROCESS_API_CLIENT_SECRET=change-me-process-secret
# Experience / Process -> System
INTERNAL_CLIENT_ID=invoice-internal-client
INTERNAL_CLIENT_SECRET=change-me-internal-secret

# ---- Simulated ERP (System API -> mock ERP) -------------------------
ERP_HOST=localhost
ERP_PORT=8090
ERP_USERNAME=erp_integration
ERP_PASSWORD=erp-local-pass

# ---- Folders --------------------------------------------------------
DOCUMENT_STORAGE_DIR=C:/invoice-data/documents
FILE_INBOUND_DIR=C:/invoice-data/inbound
FILE_ARCHIVE_DIR=C:/invoice-data/archive
